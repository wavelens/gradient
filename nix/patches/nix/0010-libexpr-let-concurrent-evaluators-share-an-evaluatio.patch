From a7ab11a44e301956b6130daddd2c1ca977f5e748 Mon Sep 17 00:00:00 2001
From: Dennis Wuitz <dennish@wuitz.de>
Date: Sun, 25 Oct 2026 00:53:54 +0200
Subject: [PATCH] libexpr: let concurrent evaluators share an evaluation cache
 file

AttrDb kept one transaction open from construction to destruction. With
several evaluators of the same flake, each in its own process, that
transaction pinned a snapshot across their reads, and in WAL mode a
write from a stale snapshot fails at once, without the busy handler.
AttrDb then gave up on the cache for the rest of the process: of 32
evaluators sharing a cache, the last writer standing was its only
contributor.

Each write now runs in an immediate transaction of its own, which waits
for the other writer instead. A placeholder reuses an existing row, as
a listing already does, since another evaluator may have cached
attributes beneath it in the meantime and a row id is the parent link
of everything cached below it.
---
 src/libexpr-tests/eval-cache.cc |  29 ++++++++
 src/libexpr/eval-cache.cc       | 118 +++++++++++++++-----------------
 2 files changed, 84 insertions(+), 63 deletions(-)

diff --git a/src/libexpr-tests/eval-cache.cc b/src/libexpr-tests/eval-cache.cc
index 9d484ff5b..e2cfb8ea8 100644
--- a/src/libexpr-tests/eval-cache.cc
+++ b/src/libexpr-tests/eval-cache.cc
@@ -186,4 +186,33 @@ TEST_F(EvalCacheTest, writeDerivationSeedsRootedPathMemo)
     EXPECT_EQ(counting->validityChecks.size() + counting->validityBatches.size(), 0);
 }
 
+TEST_F(EvalCacheTest, concurrentCachesOfOneFlakeAllWrite)
+{
+    auto fp = hashString(HashAlgorithm::SHA256, "eval-cache-test-5");
+    Value vRoot = eval(R"({ a = "1"; b = "2"; c = "3"; })");
+    unsigned rootLoads = 0;
+    auto makeCountingCache = [&]() {
+        return make_ref<EvalCache>(std::cref(fp), state, [&]() {
+            rootLoads++;
+            return &vRoot;
+        });
+    };
+
+    makeCountingCache()->getRoot()->getAttr("a")->getString();
+
+    auto second = makeCountingCache();
+    {
+        auto first = makeCountingCache();
+        EXPECT_EQ(second->getRoot()->getAttr("a")->getString(), "1");
+        EXPECT_EQ(first->getRoot()->getAttr("b")->getString(), "2");
+    }
+    EXPECT_EQ(second->getRoot()->getAttr("c")->getString(), "3");
+
+    rootLoads = 0;
+    auto third = makeCountingCache();
+    EXPECT_EQ(third->getRoot()->getAttr("b")->getString(), "2");
+    EXPECT_EQ(third->getRoot()->getAttr("c")->getString(), "3");
+    EXPECT_EQ(rootLoads, 0) << "every evaluator's writes reached the shared cache file";
+}
+
 } // namespace nix
diff --git a/src/libexpr/eval-cache.cc b/src/libexpr/eval-cache.cc
index 3cb2afb63..56d09f86c 100644
--- a/src/libexpr/eval-cache.cc
+++ b/src/libexpr/eval-cache.cc
@@ -63,7 +63,6 @@ struct AttrDb
         SQLiteStmt upsertAttribute;
         SQLiteStmt insertAttributeIfNotExists;
         SQLiteStmt deleteMissingChildren;
-        std::unique_ptr<SQLiteTxn> txn;
     };
 
     std::unique_ptr<Sync<State>> _state;
@@ -107,29 +106,34 @@ struct AttrDb
             state->db, "insert or ignore into Attributes(parent, name, type, value) values (?, ?, ?, ?)");
 
         state->deleteMissingChildren.create(state->db, "delete from Attributes where parent = ? and type = 3");
-
-        state->txn = std::make_unique<SQLiteTxn>(state->db);
-    }
-
-    ~AttrDb()
-    {
-        try {
-            auto state(_state->lock());
-            if (!failed && state->txn->active)
-                state->txn->commit();
-            state->txn.reset();
-        } catch (...) {
-            ignoreExceptionInDestructor();
-        }
     }
 
+    /* Each write is a transaction of its own, taken with the write lock up
+       front. Evaluators of the same flake share the cache file and a
+       transaction kept open across their reads pins a snapshot: in WAL mode
+       a write from a stale snapshot fails at once, without the busy handler
+       and this cache then gave up for the rest of the process. An immediate
+       transaction instead waits for the other writer. */
     template<typename F>
     AttrId doSQLite(const F & fun)
     {
         if (failed)
             return 0;
         try {
-            return fun();
+            auto state(_state->lock());
+            state->db.exec("begin immediate;");
+            try {
+                auto rowId = fun(*state);
+                state->db.exec("commit;");
+                return rowId;
+            } catch (...) {
+                try {
+                    state->db.exec("rollback;");
+                } catch (...) {
+                    ignoreExceptionExceptInterrupt();
+                }
+                throw;
+            }
         } catch (SQLiteError &) {
             ignoreExceptionExceptInterrupt();
             failed = true;
@@ -139,11 +143,9 @@ struct AttrDb
 
     AttrId setAttrs(AttrKey key, const std::vector<Symbol> & attrs)
     {
-        return doSQLite([&]() {
-            auto state(_state->lock());
-
+        return doSQLite([&](State & state) {
             // Seal the attribute names: we now know the complete set.
-            auto upsertAttribute(state->upsertAttribute.use()
+            auto upsertAttribute(state.upsertAttribute.use()
                                      .apply(key.first)
                                      .apply(symbols[key.second])
                                      .apply(AttrType::FullAttrs)
@@ -151,11 +153,11 @@ struct AttrDb
             upsertAttribute.next();
             auto rowId = (AttrId) upsertAttribute.getInt(0);
             assert(rowId);
-            state->deleteMissingChildren.use().apply(rowId).exec();
+            state.deleteMissingChildren.use().apply(rowId).exec();
 
             // Insert children as placeholders, but don't replace existing entries
             for (auto & attr : attrs)
-                state->insertAttributeIfNotExists.use()
+                state.insertAttributeIfNotExists.use()
                     .apply(rowId)
                     .apply(symbols[attr])
                     .apply(AttrType::Placeholder)
@@ -168,9 +170,7 @@ struct AttrDb
 
     AttrId setString(AttrKey key, std::string_view s, const Value::StringWithContext::Context * context = nullptr)
     {
-        return doSQLite([&]() {
-            auto state(_state->lock());
-
+        return doSQLite([&](State & state) {
             if (context) {
                 std::string ctx;
                 bool first = true;
@@ -180,7 +180,7 @@ struct AttrDb
                     ctx.append(elem->view());
                     first = false;
                 }
-                state->insertAttributeWithContext.use()
+                state.insertAttributeWithContext.use()
                     .apply(key.first)
                     .apply(symbols[key.second])
                     .apply(AttrType::String)
@@ -188,7 +188,7 @@ struct AttrDb
                     .apply(ctx)
                     .exec();
             } else {
-                state->insertAttribute.use()
+                state.insertAttribute.use()
                     .apply(key.first)
                     .apply(symbols[key.second])
                     .apply(AttrType::String)
@@ -196,119 +196,111 @@ struct AttrDb
                     .exec();
             }
 
-            return state->db.getLastInsertedRowId();
+            return state.db.getLastInsertedRowId();
         });
     }
 
     AttrId setBool(AttrKey key, bool b)
     {
-        return doSQLite([&]() {
-            auto state(_state->lock());
-
-            state->insertAttribute.use()
+        return doSQLite([&](State & state) {
+            state.insertAttribute.use()
                 .apply(key.first)
                 .apply(symbols[key.second])
                 .apply(AttrType::Bool)
                 .apply(b ? 1 : 0)
                 .exec();
 
-            return state->db.getLastInsertedRowId();
+            return state.db.getLastInsertedRowId();
         });
     }
 
     AttrId setInt(AttrKey key, int n)
     {
-        return doSQLite([&]() {
-            auto state(_state->lock());
-
-            state->insertAttribute.use()
+        return doSQLite([&](State & state) {
+            state.insertAttribute.use()
                 .apply(key.first)
                 .apply(symbols[key.second])
                 .apply(AttrType::Int)
                 .apply(n)
                 .exec();
 
-            return state->db.getLastInsertedRowId();
+            return state.db.getLastInsertedRowId();
         });
     }
 
     AttrId setListOfStrings(AttrKey key, const std::vector<std::string> & l)
     {
-        return doSQLite([&]() {
-            auto state(_state->lock());
-
-            state->insertAttribute.use()
+        return doSQLite([&](State & state) {
+            state.insertAttribute.use()
                 .apply(key.first)
                 .apply(symbols[key.second])
                 .apply(AttrType::ListOfStrings)
                 .apply(dropEmptyInitThenConcatStringsSep("\t", l))
                 .exec();
 
-            return state->db.getLastInsertedRowId();
+            return state.db.getLastInsertedRowId();
         });
     }
 
     AttrId setPlaceholder(AttrKey key)
     {
-        return doSQLite([&]() {
-            auto state(_state->lock());
-
-            state->insertAttribute.use()
+        return doSQLite([&](State & state) {
+            /* Another evaluator may have inserted the row and cached members
+               beneath it since this cursor looked it up. Those members hang off
+               the row id, so the row is kept rather than replaced. */
+            state.insertAttributeIfNotExists.use()
                 .apply(key.first)
                 .apply(symbols[key.second])
                 .apply(AttrType::Placeholder)
                 .apply(0, false)
                 .exec();
 
-            return state->db.getLastInsertedRowId();
+            auto queryAttribute(state.queryAttribute.use().apply(key.first).apply(symbols[key.second]));
+            if (!queryAttribute.next())
+                throw Error("placeholder for '%s' vanished from the evaluation cache", symbols[key.second]);
+            return (AttrId) queryAttribute.getInt(0);
         });
     }
 
     AttrId setMissing(AttrKey key)
     {
-        return doSQLite([&]() {
-            auto state(_state->lock());
-
-            state->insertAttribute.use()
+        return doSQLite([&](State & state) {
+            state.insertAttribute.use()
                 .apply(key.first)
                 .apply(symbols[key.second])
                 .apply(AttrType::Missing)
                 .apply(0, false)
                 .exec();
 
-            return state->db.getLastInsertedRowId();
+            return state.db.getLastInsertedRowId();
         });
     }
 
     AttrId setMisc(AttrKey key)
     {
-        return doSQLite([&]() {
-            auto state(_state->lock());
-
-            state->insertAttribute.use()
+        return doSQLite([&](State & state) {
+            state.insertAttribute.use()
                 .apply(key.first)
                 .apply(symbols[key.second])
                 .apply(AttrType::Misc)
                 .apply(0, false)
                 .exec();
 
-            return state->db.getLastInsertedRowId();
+            return state.db.getLastInsertedRowId();
         });
     }
 
     AttrId setFailed(AttrKey key)
     {
-        return doSQLite([&]() {
-            auto state(_state->lock());
-
-            state->insertAttribute.use()
+        return doSQLite([&](State & state) {
+            state.insertAttribute.use()
                 .apply(key.first)
                 .apply(symbols[key.second])
                 .apply(AttrType::Failed)
                 .apply(0, false)
                 .exec();
 
-            return state->db.getLastInsertedRowId();
+            return state.db.getLastInsertedRowId();
         });
     }
 
