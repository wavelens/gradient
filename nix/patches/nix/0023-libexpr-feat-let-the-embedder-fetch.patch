+static StorePath fetchThroughHook(
+    EvalState & state,
+    const std::string & who,
+    const std::string & url,
+    const std::string & name,
+    const std::optional<Hash> & expectedHash,
+    const std::optional<StorePath> & expectedPath)
+{
+    auto args = nlohmann::json{{"url", url}, {"name", name}};
+    if (expectedHash)
+        args["sha256"] = expectedHash->to_string(HashFormat::SRI, true);
+    auto request = nlohmann::json{{"builtin", who}, {"args", args}};
+    if (expectedPath)
+        request["storePath"] = state.store->printStorePath(*expectedPath);
+
+    auto response = nlohmann::json::parse(state.fetchSettings.fetchHook(request.dump()));
+    auto storePath = state.store->parseStorePath(getString(valueAt(getObject(response), "storePath")));
+    if (expectedPath && storePath != *expectedPath)
+        throw Error(
+            "the fetch hook returned '%s' for '%s', expected '%s'",
+            state.store->printStorePath(storePath),
+            url,
+            state.store->printStorePath(*expectedPath));
+    if (!state.store->isValidPath(storePath))
+        throw Error(
+            "the fetch hook returned '%s', which is not valid in the store", state.store->printStorePath(storePath));
+    return storePath;
+}
