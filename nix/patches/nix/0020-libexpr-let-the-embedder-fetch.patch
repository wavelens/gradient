 src/libexpr-c/nix_api_expr.h                  | 34 ++++++++
 src/libexpr-tests/nix_api_expr.cc             | 41 +++++++++
 src/libexpr/primops/fetchTree.cc              | 33 ++++++--
 src/libfetchers/fetchers.cc                   | 84 +++++++++++++++----
 .../include/nix/fetchers/fetch-settings.hh    |  8 ++
 .../include/nix/fetchers/fetchers.hh          |  8 ++
 7 files changed, 205 insertions(+), 22 deletions(-)

diff --git a/src/libexpr-c/nix_api_expr.cc b/src/libexpr-c/nix_api_expr.cc
index 7b6f34069..e863b66d1 100644
--- a/src/libexpr-c/nix_api_expr.cc
+++ b/src/libexpr-c/nix_api_expr.cc
@@ -228,6 +228,25 @@ nix_err nix_eval_state_builder_set_realise_hook(
     NIXC_CATCH_ERRS
 }
 
+nix_err nix_eval_state_builder_set_fetch_hook(
+    nix_c_context * context, nix_eval_state_builder * builder, nix_fetch_hook hook, void * user_data)
+{
+    nix_clear_err(context);
+    try {
+        builder->fetchSettings.fetchHook = [hook, user_data](const std::string & request) {
+            std::string response;
+            auto setResponse = [](const char * start, unsigned int n, void * data) {
+                static_cast<std::string *>(data)->assign(start, n);
+            };
+            nix_c_context hookContext;
+            if (hook(user_data, &hookContext, request.c_str(), setResponse, &response) != NIX_OK)
+                throw nix::Error("%s", hookContext.last_err.value_or("fetch hook failed"));
+            return response;
+        };
+    }
+    NIXC_CATCH_ERRS
+}
+
 EvalState * nix_eval_state_build(nix_c_context * context, nix_eval_state_builder * builder)
 {
     if (context)
diff --git a/src/libexpr-c/nix_api_expr.h b/src/libexpr-c/nix_api_expr.h
index 877dbcad6..e7975a751 100644
--- a/src/libexpr-c/nix_api_expr.h
+++ b/src/libexpr-c/nix_api_expr.h
@@ -274,6 +274,40 @@ typedef nix_err (*nix_realise_hook)(
 nix_err nix_eval_state_builder_set_realise_hook(
     nix_c_context * context, nix_eval_state_builder * builder, nix_realise_hook hook, void * user_data);
 
+/**
+ * @brief Callback that fetches an input missing from the store
+ * @ingroup libexpr_init
+ *
+ * @param[in] user_data The pointer passed to nix_eval_state_builder_set_fetch_hook().
+ * @param[out] context Stores the error message when the fetch fails.
+ * @param[in] request_json `{"builtin": "fetchTree" | "fetchTarball" | "fetchurl", "args": {...}, "storePath"?: "..."}`.
+ * @param[in] callback Called with the response `{"storePath": "...", "attrs"?: {...}}`.
+ * @param[in] callback_user_data Passed to the callback unchanged.
+ * @return NIX_OK once the response's store path is valid in the store, an error code otherwise.
+ */
+typedef nix_err (*nix_fetch_hook)(
+    void * user_data,
+    nix_c_context * context,
+    const char * request_json,
+    nix_get_string_callback callback,
+    void * callback_user_data);
+
+/**
+ * @brief Let the embedder fetch inputs that are not in the store
+ * @ingroup libexpr_init
+ *
+ * The hook replaces the built-in fetchers for every input except `path`, and the download of
+ * `fetchurl` and `fetchTarball`. user_data must stay valid as long as the state built from this builder.
+ *
+ * @param[out] context Optional, stores error information
+ * @param[in] builder The builder to modify.
+ * @param[in] hook The callback that fetches the input.
+ * @param[in] user_data Passed to the hook unchanged.
+ * @return NIX_OK if successful, an error code otherwise.
+ */
+nix_err nix_eval_state_builder_set_fetch_hook(
+    nix_c_context * context, nix_eval_state_builder * builder, nix_fetch_hook hook, void * user_data);
+
 /**
  * @brief Create a new Nix language evaluator state
  * @ingroup libexpr_init
diff --git a/src/libexpr-tests/nix_api_expr.cc b/src/libexpr-tests/nix_api_expr.cc
index dbf45cbaa..b7007952a 100644
--- a/src/libexpr-tests/nix_api_expr.cc
+++ b/src/libexpr-tests/nix_api_expr.cc
@@ -757,4 +757,45 @@ TEST_F(nix_api_expr_test, nix_eval_state_builder_set_realise_hook)
     nix_state_free(hookedState);
 }
 
+static nix_err recordingFetchHook(
+    void * user_data,
+    nix_c_context * context,
+    const char * request_json,
+    nix_get_string_callback callback,
+    void * callback_user_data)
+{
+    *static_cast<std::string *>(user_data) = request_json;
+    return nix_set_err_msg(context, NIX_ERR_UNKNOWN, "left to the embedder");
+}
+
+TEST_F(nix_api_expr_test, nix_eval_state_builder_set_fetch_hook)
+{
+    std::string request;
+    auto builder = nix_eval_state_builder_new(ctx, store);
+    assert_ctx_ok();
+    ASSERT_EQ(NIX_OK, nix_eval_state_builder_set_fetch_hook(ctx, builder, recordingFetchHook, &request));
+    assert_ctx_ok();
+    auto hookedState = nix_eval_state_build(ctx, builder);
+    assert_ctx_ok();
+    nix_eval_state_builder_free(builder);
+
+    auto fetched = nix_alloc_value(ctx, hookedState);
+    auto err = nix_expr_eval_from_string(
+        ctx,
+        hookedState,
+        R"(builtins.fetchurl { url = "https://example.invalid/source.tar.gz"; name = "source"; })",
+        ".",
+        fetched);
+    ASSERT_EQ(NIX_ERR_NIX_ERROR, err);
+    ASSERT_THAT(nix_err_msg(nullptr, ctx, nullptr), testing::HasSubstr("left to the embedder"));
+    ASSERT_EQ(
+        nlohmann::json::parse(request),
+        nlohmann::json(
+            {{"builtin", "fetchurl"},
+             {"args", {{"url", "https://example.invalid/source.tar.gz"}, {"name", "source"}}}}));
+
+    nix_value_decref(ctx, fetched);
+    nix_state_free(hookedState);
+}
+
 } // namespace nixC
