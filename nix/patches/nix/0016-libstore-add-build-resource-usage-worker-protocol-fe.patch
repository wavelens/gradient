From 54b37045d118b10efadf66f76329813eaf2efdf2 Mon Sep 17 00:00:00 2001
From: Dennis Wuitz <dennish@wuitz.de>
Date: Sun, 4 Oct 2026 11:04:28 +0200
Subject: [PATCH] libstore: add build-resource-usage worker protocol feature

When negotiated, BuildResult carries memoryPeak, ioReadBytes,
ioWriteBytes and oomKills after cpuSystem, each as an optional 64-bit
number.
---
 src/libstore-tests/worker-protocol.cc         | 72 +++++++++++++++++++
 .../include/nix/store/worker-protocol.hh      |  8 +++
 src/libstore/worker-protocol.cc               | 37 ++++++++++
 3 files changed, 117 insertions(+)

diff --git a/src/libstore-tests/worker-protocol.cc b/src/libstore-tests/worker-protocol.cc
index 91acde738..fc8b1c372 100644
--- a/src/libstore-tests/worker-protocol.cc
+++ b/src/libstore-tests/worker-protocol.cc
@@ -1094,4 +1094,76 @@ VERSIONED_CHARACTERIZATION_TEST(
         t;
     }))
 
+static std::string
+writeBuildResult(const StoreDirConfig & store, const WorkerProto::Version & version, const BuildResult & result)
+{
+    StringSink to;
+    WorkerProto::write(store, WorkerProto::WriteConn{.to = to, .version = version}, result);
+    return std::move(to.s);
+}
+
+static BuildResult
+readBuildResult(const StoreDirConfig & store, const WorkerProto::Version & version, std::string_view encoded)
+{
+    StringSource from{encoded};
+    return WorkerProto::Serialise<BuildResult>::read(store, WorkerProto::ReadConn{.from = from, .version = version});
+}
+
+static const std::vector<BuildResult> buildResultsWithResourceUsage{
+    BuildResult{
+        .inner{BuildResult::Success{.status = BuildResult::Success::Built}},
+        .timesBuilt = 1,
+        .startTime = 30,
+        .stopTime = 50,
+        .cpuUser = std::chrono::microseconds(500),
+        .cpuSystem = std::chrono::microseconds(604),
+        .memoryPeak = 1073741824,
+        .ioReadBytes = 4096,
+        .oomKills = 0,
+    },
+    BuildResult{
+        .inner{BuildResult::Failure{{
+            .status = BuildResult::Failure::PermanentFailure,
+            .msg = HintFmt("builder was killed"),
+        }}},
+        .timesBuilt = 1,
+        .startTime = 30,
+        .stopTime = 50,
+        .memoryPeak = 2147483648,
+        .ioWriteBytes = 8192,
+        .oomKills = 3,
+    },
+};
+
+TEST_F(WorkerProtoTest, buildResult_resource_usage_round_trip)
+{
+    WorkerProto::Version version{
+        .number = {.major = 1, .minor = 38},
+        .features = {"realisation-with-path-not-hash", "build-resource-usage"},
+    };
+
+    for (auto & result : buildResultsWithResourceUsage)
+        EXPECT_EQ(readBuildResult(store, version, writeBuildResult(store, version, result)), result);
+}
+
+TEST_F(WorkerProtoTest, buildResult_resource_usage_needs_feature)
+{
+    WorkerProto::Version version{
+        .number = {.major = 1, .minor = 38},
+        .features = {"realisation-with-path-not-hash"},
+    };
+
+    for (auto & result : buildResultsWithResourceUsage) {
+        auto withoutResourceUsage = result;
+        withoutResourceUsage.memoryPeak = std::nullopt;
+        withoutResourceUsage.ioReadBytes = std::nullopt;
+        withoutResourceUsage.ioWriteBytes = std::nullopt;
+        withoutResourceUsage.oomKills = std::nullopt;
+
+        auto encoded = writeBuildResult(store, version, result);
+        EXPECT_EQ(encoded, writeBuildResult(store, version, withoutResourceUsage));
+        EXPECT_EQ(readBuildResult(store, version, encoded), withoutResourceUsage);
+    }
+}
+
 } // namespace nix
diff --git a/src/libstore/include/nix/store/worker-protocol.hh b/src/libstore/include/nix/store/worker-protocol.hh
index d09d30421..55ae493f0 100644
--- a/src/libstore/include/nix/store/worker-protocol.hh
+++ b/src/libstore/include/nix/store/worker-protocol.hh
@@ -135,6 +135,12 @@ struct WorkerProto
      */
     static constexpr std::string_view featureDisableSetOptions = "disable-set-options";
 
+    /**
+     * Feature for transmitting the peak memory, block I/O and
+     * out-of-memory kill count of a build in `BuildResult`.
+     */
+    static constexpr std::string_view featureBuildResourceUsage = "build-resource-usage";
+
     /**
      * A unidirectional read connection, to be used by the read half of the
      * canonical serializers below.
@@ -349,6 +355,8 @@ DECLARE_WORKER_SERIALISER(std::optional<TrustedFlag>);
 template<>
 DECLARE_WORKER_SERIALISER(std::optional<std::chrono::microseconds>);
 template<>
+DECLARE_WORKER_SERIALISER(std::optional<uint64_t>);
+template<>
 DECLARE_WORKER_SERIALISER(WorkerProto::ClientHandshakeInfo);
 
 template<>
diff --git a/src/libstore/worker-protocol.cc b/src/libstore/worker-protocol.cc
index 37aa4e31b..c82c37c27 100644
--- a/src/libstore/worker-protocol.cc
+++ b/src/libstore/worker-protocol.cc
@@ -29,6 +29,7 @@ const WorkerProto::Version WorkerProto::latest = {
                 WorkerProto::featureRealisationWithPath,
             },
             std::string{WorkerProto::featureDeleteDeadSpecificReferrers},
+            std::string{WorkerProto::featureBuildResourceUsage},
         },
 };
 
@@ -191,6 +192,30 @@ void WorkerProto::Serialise<std::optional<std::chrono::microseconds>>::write(
     }
 }
 
+std::optional<uint64_t>
+WorkerProto::Serialise<std::optional<uint64_t>>::read(const StoreDirConfig & store, WorkerProto::ReadConn conn)
+{
+    auto tag = readNum<uint8_t>(conn.from);
+    switch (tag) {
+    case 0:
+        return std::nullopt;
+    case 1:
+        return readNum<uint64_t>(conn.from);
+    default:
+        throw Error("Invalid optional tag from remote");
+    }
+}
+
+void WorkerProto::Serialise<std::optional<uint64_t>>::write(
+    const StoreDirConfig & store, WorkerProto::WriteConn conn, const std::optional<uint64_t> & optValue)
+{
+    if (!optValue.has_value()) {
+        conn.to << uint8_t{0};
+    } else {
+        conn.to << uint8_t{1} << *optValue;
+    }
+}
+
 DerivedPath WorkerProto::Serialise<DerivedPath>::read(const StoreDirConfig & store, WorkerProto::ReadConn conn)
 {
     auto s = readString(conn.from);
@@ -264,6 +289,12 @@ BuildResult WorkerProto::Serialise<BuildResult>::read(const StoreDirConfig & sto
         res.cpuUser = WorkerProto::Serialise<std::optional<std::chrono::microseconds>>::read(store, conn);
         res.cpuSystem = WorkerProto::Serialise<std::optional<std::chrono::microseconds>>::read(store, conn);
     }
+    if (conn.version.features.contains(WorkerProto::featureBuildResourceUsage)) {
+        res.memoryPeak = WorkerProto::Serialise<std::optional<uint64_t>>::read(store, conn);
+        res.ioReadBytes = WorkerProto::Serialise<std::optional<uint64_t>>::read(store, conn);
+        res.ioWriteBytes = WorkerProto::Serialise<std::optional<uint64_t>>::read(store, conn);
+        res.oomKills = WorkerProto::Serialise<std::optional<uint64_t>>::read(store, conn);
+    }
 
     if (conn.version.features.contains(WorkerProto::featureRealisationWithPath)) {
         success.builtOutputs = WorkerProto::Serialise<std::map<OutputName, UnkeyedRealisation>>::read(store, conn);
@@ -315,6 +346,12 @@ void WorkerProto::Serialise<BuildResult>::write(
             WorkerProto::write(store, conn, res.cpuUser);
             WorkerProto::write(store, conn, res.cpuSystem);
         }
+        if (conn.version.features.contains(WorkerProto::featureBuildResourceUsage)) {
+            WorkerProto::write(store, conn, res.memoryPeak);
+            WorkerProto::write(store, conn, res.ioReadBytes);
+            WorkerProto::write(store, conn, res.ioWriteBytes);
+            WorkerProto::write(store, conn, res.oomKills);
+        }
 
         if (conn.version.features.contains(WorkerProto::featureRealisationWithPath)) {
             WorkerProto::write(store, conn, builtOutputs);
