From b3bd518d9a4c28af40688633f877028e1063bbd3 Mon Sep 17 00:00:00 2001
From: Dennis Wuitz <dennish@wuitz.de>
Date: Thu, 8 Oct 2026 11:03:35 +0200
Subject: [PATCH] libexpr: let the embedder realise an import from derivation

An embedder with a build system of its own, such as a CI, has no say in
how an import from derivation is built: realiseContext() always builds
through the store. EvalSettings::realiseHook replaces that build when
set, and nix_eval_state_builder_set_realise_hook() installs a C
callback as the hook. The embedder only has to make the outputs valid
in the evaluation store before it returns.

With a hook set, the failed-realisation memo stays off: the embedder
decides how long a failure holds, since its evaluator can outlive one
evaluation.
---
 src/libexpr-c/nix_api_expr.cc                 | 23 ++++++++++++
 src/libexpr-c/nix_api_expr.h                  | 29 +++++++++++++++
 src/libexpr-tests/nix_api_expr.cc             | 35 +++++++++++++++++++
 src/libexpr/include/nix/expr/eval-settings.hh | 10 ++++++
 src/libexpr/primops.cc                        |  7 ++--
 5 files changed, 102 insertions(+), 2 deletions(-)

diff --git a/src/libexpr-c/nix_api_expr.cc b/src/libexpr-c/nix_api_expr.cc
index 5b5859ee7..7b6f34069 100644
--- a/src/libexpr-c/nix_api_expr.cc
+++ b/src/libexpr-c/nix_api_expr.cc
@@ -205,6 +205,29 @@ nix_err nix_eval_state_builder_set_setting(
     NIXC_CATCH_ERRS
 }
 
+nix_err nix_eval_state_builder_set_realise_hook(
+    nix_c_context * context, nix_eval_state_builder * builder, nix_realise_hook hook, void * user_data)
+{
+    nix_clear_err(context);
+    try {
+        builder->settings.realiseHook =
+            [hook, user_data, store = builder->store](const std::vector<nix::DerivedPath::Built> & drvs) {
+                std::vector<std::string> owned;
+                owned.reserve(drvs.size());
+                for (auto & drv : drvs)
+                    owned.push_back(drv.to_string(*store));
+                std::vector<const char *> paths;
+                paths.reserve(owned.size());
+                for (auto & path : owned)
+                    paths.push_back(path.c_str());
+                nix_c_context hookContext;
+                if (hook(user_data, &hookContext, paths.data(), paths.size()) != NIX_OK)
+                    throw nix::Error("%s", hookContext.last_err.value_or("import from derivation failed"));
+            };
+    }
+    NIXC_CATCH_ERRS
+}
+
 EvalState * nix_eval_state_build(nix_c_context * context, nix_eval_state_builder * builder)
 {
     if (context)
diff --git a/src/libexpr-c/nix_api_expr.h b/src/libexpr-c/nix_api_expr.h
index 6091282fb..877dbcad6 100644
--- a/src/libexpr-c/nix_api_expr.h
+++ b/src/libexpr-c/nix_api_expr.h
@@ -245,6 +245,35 @@ nix_err nix_eval_state_builder_set_lookup_path(
 nix_err nix_eval_state_builder_set_setting(
     nix_c_context * context, nix_eval_state_builder * builder, const char * key, const char * value);
 
+/**
+ * @brief Callback that realises the derivations of an import from derivation
+ * @ingroup libexpr_init
+ *
+ * @param[in] user_data The pointer passed to nix_eval_state_builder_set_realise_hook().
+ * @param[out] context Stores the error message when the realisation fails.
+ * @param[in] derived_paths Derived paths in the form `/nix/store/<hash>-<name>.drv^out1,out2`.
+ * @param[in] count The number of entries in derived_paths.
+ * @return NIX_OK once the outputs and their closure are valid in the store, an error code otherwise.
+ */
+typedef nix_err (*nix_realise_hook)(
+    void * user_data, nix_c_context * context, const char ** derived_paths, size_t count);
+
+/**
+ * @brief Let the embedder realise the derivations of an import from derivation
+ * @ingroup libexpr_init
+ *
+ * The hook replaces the build through the store. The evaluator state keeps the hook, so
+ * user_data must stay valid as long as the state built from this builder.
+ *
+ * @param[out] context Optional, stores error information
+ * @param[in] builder The builder to modify.
+ * @param[in] hook The callback that realises the derivations.
+ * @param[in] user_data Passed to the hook unchanged.
+ * @return NIX_OK if successful, an error code otherwise.
+ */
+nix_err nix_eval_state_builder_set_realise_hook(
+    nix_c_context * context, nix_eval_state_builder * builder, nix_realise_hook hook, void * user_data);
+
 /**
  * @brief Create a new Nix language evaluator state
  * @ingroup libexpr_init
diff --git a/src/libexpr-tests/nix_api_expr.cc b/src/libexpr-tests/nix_api_expr.cc
index 8ffa8ea49..dbf45cbaa 100644
--- a/src/libexpr-tests/nix_api_expr.cc
+++ b/src/libexpr-tests/nix_api_expr.cc
@@ -722,4 +722,39 @@ TEST_F(nix_api_expr_test, nix_eval_state_get_stats)
     ASSERT_GE(after.nr_lookups, before.nr_lookups);
 }
 
+static nix_err
+recordingRealiseHook(void * user_data, nix_c_context * context, const char ** derived_paths, size_t count)
+{
+    auto & seen = *static_cast<std::vector<std::string> *>(user_data);
+    for (size_t i = 0; i < count; i++)
+        seen.emplace_back(derived_paths[i]);
+    return nix_set_err_msg(context, NIX_ERR_UNKNOWN, "left to the embedder");
+}
+
+TEST_F(nix_api_expr_test, nix_eval_state_builder_set_realise_hook)
+{
+    std::vector<std::string> seen;
+    auto builder = nix_eval_state_builder_new(ctx, store);
+    assert_ctx_ok();
+    ASSERT_EQ(NIX_OK, nix_eval_state_builder_set_realise_hook(ctx, builder, recordingRealiseHook, &seen));
+    assert_ctx_ok();
+    auto hookedState = nix_eval_state_build(ctx, builder);
+    assert_ctx_ok();
+    nix_eval_state_builder_free(builder);
+
+    auto imported = nix_alloc_value(ctx, hookedState);
+    auto err = nix_expr_eval_from_string(
+        ctx,
+        hookedState,
+        R"(import (derivation { name = "broken"; system = "x86_64-linux"; builder = "/bin/sh"; }))",
+        ".",
+        imported);
+    ASSERT_EQ(NIX_ERR_NIX_ERROR, err);
+    ASSERT_THAT(nix_err_msg(nullptr, ctx, nullptr), testing::HasSubstr("left to the embedder"));
+    ASSERT_THAT(seen, testing::ElementsAre(testing::EndsWith("-broken.drv^out")));
+
+    nix_value_decref(ctx, imported);
+    nix_state_free(hookedState);
+}
+
 } // namespace nixC
diff --git a/src/libexpr/include/nix/expr/eval-settings.hh b/src/libexpr/include/nix/expr/eval-settings.hh
index d8a1fb973..f9ae78427 100644
--- a/src/libexpr/include/nix/expr/eval-settings.hh
+++ b/src/libexpr/include/nix/expr/eval-settings.hh
@@ -3,6 +3,7 @@
 
 #include "nix/expr/diagnose.hh"
 #include "nix/expr/eval-profiler-settings.hh"
+#include "nix/store/derived-path.hh"
 #include "nix/util/configuration.hh"
 #include "nix/util/source-path.hh"
 
@@ -96,6 +97,15 @@ public:
 
     std::vector<PrimOp> extraPrimOps;
 
+    /**
+     * Realises the derivations of an import from derivation instead of
+     * `buildPaths`. On return, the outputs and their closure must be valid in
+     * the evaluation store. Throws `Error` on failure.
+     */
+    using RealiseHook = std::function<void(const std::vector<DerivedPath::Built> &)>;
+
+    RealiseHook realiseHook;
+
     Setting<bool> enableNativeCode{this, false, "allow-unsafe-native-code-during-evaluation", R"(
         Enable built-in functions that allow executing native code.
 
diff --git a/src/libexpr/primops.cc b/src/libexpr/primops.cc
index 5bcbbc288..9846cecf8 100644
--- a/src/libexpr/primops.cc
+++ b/src/libexpr/primops.cc
@@ -137,9 +137,12 @@ StringMap EvalState::realiseContext(const NixStringContext & context, StorePathS
             std::rethrow_exception(*failed);
 
     try {
-        buildStore->buildPaths(buildReqs, bmNormal, store);
+        if (settings.realiseHook)
+            settings.realiseHook(drvs);
+        else
+            buildStore->buildPaths(buildReqs, bmNormal, store);
     } catch (Error &) {
-        if (drvs.size() == 1)
+        if (drvs.size() == 1 && !settings.realiseHook)
             failedRealisations->insert_or_assign(drvs.front().drvPath->getBaseStorePath(), std::current_exception());
         throw;
     }
