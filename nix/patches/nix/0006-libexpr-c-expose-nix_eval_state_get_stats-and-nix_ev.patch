From 7986511548aace48bf0e45c5ed8d8b1d7c3f71a3 Mon Sep 17 00:00:00 2001
From: Dennis Wuitz <dennish@wuitz.de>
Date: Sun, 25 Oct 2026 00:47:29 +0200
Subject: [PATCH] libexpr-c: expose nix_eval_state_get_stats and
 nix_eval_state_get_stats_json

An embedder that runs many evaluations in one EvalState needs to
attribute cost to each of them. nix_eval_state_get_stats_json() returns
the statistics NIX_SHOW_STATS prints; nix_eval_state_get_stats() fills a
struct with the counters only, without allocation.
---
 src/libexpr-c/nix_api_expr.cc     | 41 +++++++++++++++++++++
 src/libexpr-c/nix_api_expr.h      | 61 +++++++++++++++++++++++++++++++
 src/libexpr-tests/nix_api_expr.cc | 47 ++++++++++++++++++++++++
 3 files changed, 149 insertions(+)

diff --git a/src/libexpr-c/nix_api_expr.cc b/src/libexpr-c/nix_api_expr.cc
index 9c6bcefc3..5b5859ee7 100644
--- a/src/libexpr-c/nix_api_expr.cc
+++ b/src/libexpr-c/nix_api_expr.cc
@@ -2,6 +2,9 @@
 #include <stdexcept>
 #include <string>
 
+#include <nlohmann/json.hpp>
+
+#include "nix/expr/counter.hh"
 #include "nix/expr/eval.hh"
 #include "nix/expr/eval-gc.hh"
 #include "nix/store/globals.hh"
@@ -103,6 +106,44 @@ nix_err nix_value_force_deep(nix_c_context * context, EvalState * state, nix_val
     NIXC_CATCH_ERRS
 }
 
+nix_err nix_eval_stats_enable(nix_c_context * context)
+{
+    nix_clear_err(context);
+    try {
+        nix::Counter::enabled = true;
+    }
+    NIXC_CATCH_ERRS
+}
+
+nix_err nix_eval_state_get_stats_json(
+    nix_c_context * context, EvalState * state, nix_get_string_callback callback, void * user_data)
+{
+    nix_clear_err(context);
+    try {
+        return call_nix_get_string_callback(state->state.getStatisticsJSON().dump(), callback, user_data);
+    }
+    NIXC_CATCH_ERRS
+}
+
+nix_err nix_eval_state_get_stats(nix_c_context * context, EvalState * state, nix_eval_stats * out)
+{
+    nix_clear_err(context);
+    try {
+        auto s = state->state.getStats();
+        *out = nix_eval_stats{
+            .nr_thunks = s.nrThunks,
+            .nr_function_calls = s.nrFunctionCalls,
+            .nr_primop_calls = s.nrPrimOpCalls,
+            .nr_lookups = s.nrLookups,
+            .nr_op_updates = s.nrOpUpdates,
+            .gc_heap_size = s.gcHeapSize,
+            .gc_total_bytes = s.gcTotalBytes,
+        };
+        return NIX_OK;
+    }
+    NIXC_CATCH_ERRS
+}
+
 nix_eval_state_builder * nix_eval_state_builder_new(nix_c_context * context, Store * store)
 {
     if (context)
diff --git a/src/libexpr-c/nix_api_expr.h b/src/libexpr-c/nix_api_expr.h
index fca88e5c0..6091282fb 100644
--- a/src/libexpr-c/nix_api_expr.h
+++ b/src/libexpr-c/nix_api_expr.h
@@ -16,6 +16,7 @@
 #include "nix_api_store.h"
 #include "nix_api_util.h"
 #include <stddef.h>
+#include <stdint.h>
 
 #ifndef __has_c_attribute
 #  define __has_c_attribute(x) 0
@@ -292,6 +293,66 @@ EvalState * nix_state_create(nix_c_context * context, const char ** lookupPath,
  */
 void nix_state_free(EvalState * state);
 
+/**
+ * @brief Get the evaluation statistics of a state as a JSON string.
+ *
+ * The same data Nix writes when `NIX_SHOW_STATS` is set: CPU time, the
+ * number of thunks, function calls, allocations, GC and symbol table
+ * statistics.
+ *
+ * @param[out] context Optional, stores error information
+ * @param[in] state The evaluator state to read statistics from
+ * @param[in] callback Called with the JSON string
+ * @param[in] user_data Optional, passed to the callback
+ * @return NIX_OK if there were no errors.
+ */
+nix_err nix_eval_state_get_stats_json(
+    nix_c_context * context, EvalState * state, nix_get_string_callback callback, void * user_data);
+
+/**
+ * @brief Turn on the evaluation counters.
+ *
+ * The counters stay at zero unless this is called before evaluation starts,
+ * or the environment variable `NIX_SHOW_STATS` is set, since counting costs
+ * in multi-threaded evaluation. Applies to every evaluator state.
+ *
+ * @param[out] context Optional, stores error information
+ * @return NIX_OK if there were no errors.
+ */
+nix_err nix_eval_stats_enable(nix_c_context * context);
+
+/**
+ * @brief The cumulative evaluation counters of a state.
+ *
+ * The counters only grow over the lifetime of a state, so the cost of one
+ * evaluation is the difference of two readings. They stay at zero without
+ * nix_eval_stats_enable(). The GC fields are zero when Nix was built
+ * without Boehm GC.
+ */
+typedef struct nix_eval_stats
+{
+    uint64_t nr_thunks;
+    uint64_t nr_function_calls;
+    uint64_t nr_primop_calls;
+    uint64_t nr_lookups;
+    uint64_t nr_op_updates;
+    uint64_t gc_heap_size;
+    uint64_t gc_total_bytes;
+} nix_eval_stats;
+
+/**
+ * @brief Read the evaluation counters of a state.
+ *
+ * Cheap enough to call before and after every evaluation, unlike
+ * nix_eval_state_get_stats_json() which serializes all statistics.
+ *
+ * @param[out] context Optional, stores error information
+ * @param[in] state The evaluator state to read the counters from
+ * @param[out] out Filled with the current counters
+ * @return NIX_OK if there were no errors.
+ */
+nix_err nix_eval_state_get_stats(nix_c_context * context, EvalState * state, nix_eval_stats * out);
+
 /** @addtogroup GC
  * @ingroup libexpr
  * @brief Reference counting and garbage collector operations
diff --git a/src/libexpr-tests/nix_api_expr.cc b/src/libexpr-tests/nix_api_expr.cc
index 3ceb0a24c..8ffa8ea49 100644
--- a/src/libexpr-tests/nix_api_expr.cc
+++ b/src/libexpr-tests/nix_api_expr.cc
@@ -10,6 +10,8 @@
 #include <gmock/gmock.h>
 #include <gtest/gtest.h>
 
+#include <nlohmann/json.hpp>
+
 #include "expr-tests-config.hh"
 
 namespace nixC {
@@ -675,4 +677,49 @@ TEST_F(nix_api_expr_test, nix_expr_thunk_re_evaluation_after_deployment)
     ASSERT_STREQ("vm-12345", result.c_str());
 }
 
+TEST_F(nix_api_expr_test, nix_eval_state_get_stats_json)
+{
+    auto value = nix_alloc_value(ctx, state);
+    nix_expr_eval_from_string(ctx, state, "let f = x: x + x; in f 21", ".", value);
+    assert_ctx_ok();
+    nix_value_force(ctx, state, value);
+    assert_ctx_ok();
+
+    std::string statsJson;
+    auto r = nix_eval_state_get_stats_json(ctx, state, OBSERVE_STRING(statsJson));
+    assert_ctx_ok();
+    ASSERT_EQ(NIX_OK, r);
+
+    auto j = nlohmann::json::parse(statsJson);
+    ASSERT_TRUE(j.contains("cpuTime"));
+    ASSERT_TRUE(j.contains("nrThunks"));
+    ASSERT_TRUE(j.contains("envs"));
+    ASSERT_TRUE(j["envs"].contains("bytes"));
+}
+
+TEST_F(nix_api_expr_test, nix_eval_state_get_stats)
+{
+    ASSERT_EQ(NIX_OK, nix_eval_stats_enable(ctx));
+    assert_ctx_ok();
+
+    nix_eval_stats before{};
+    ASSERT_EQ(NIX_OK, nix_eval_state_get_stats(ctx, state, &before));
+    assert_ctx_ok();
+
+    auto value = nix_alloc_value(ctx, state);
+    nix_expr_eval_from_string(ctx, state, "let f = x: x + x; in f 21", ".", value);
+    assert_ctx_ok();
+    nix_value_force(ctx, state, value);
+    assert_ctx_ok();
+
+    nix_eval_stats after{};
+    ASSERT_EQ(NIX_OK, nix_eval_state_get_stats(ctx, state, &after));
+    assert_ctx_ok();
+
+    ASSERT_GT(after.nr_function_calls, before.nr_function_calls);
+    ASSERT_GE(after.nr_thunks, before.nr_thunks);
+    ASSERT_GE(after.nr_primop_calls, before.nr_primop_calls);
+    ASSERT_GE(after.nr_lookups, before.nr_lookups);
+}
+
 } // namespace nixC
