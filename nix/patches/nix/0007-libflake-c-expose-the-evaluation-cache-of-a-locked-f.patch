From c01de1eea0010c14f9131f9232455ce1b4bd091c Mon Sep 17 00:00:00 2001
From: Dennis Wuitz <dennish@wuitz.de>
Date: Sun, 25 Oct 2026 00:49:01 +0200
Subject: [PATCH] libflake-c: expose the evaluation cache of a locked flake

The `nix` command walks the outputs of a flake through `AttrCursor`, so
an attribute it has seen before costs no evaluation. A C API consumer
that enumerates the same outputs had to evaluate them every time.

nix_eval_cache_open() opens the cache of a locked flake and
nix_attr_cursor walks it, with the getters AttrCursor has for the
values the cache can hold. nix_attr_cursor_force_value() returns any
other value for the regular value API. nix_eval_cache_checkpoint()
folds the write-ahead log into the database file, for a consumer that
copies the file elsewhere.
---
 src/libexpr/eval-cache.cc                     |  12 ++
 src/libexpr/include/nix/expr/eval-cache.hh    |   8 +
 src/libflake-c/meson.build                    |   3 +
 src/libflake-c/nix_api_eval_cache.cc          | 157 +++++++++++++++
 src/libflake-c/nix_api_eval_cache.h           | 180 ++++++++++++++++++
 src/libflake-c/nix_api_eval_cache_internal.hh |  13 ++
 src/libflake-tests/meson.build                |   1 +
 src/libflake-tests/nix_api_eval_cache.cc      | 168 ++++++++++++++++
 8 files changed, 542 insertions(+)
 create mode 100644 src/libflake-c/nix_api_eval_cache.cc
 create mode 100644 src/libflake-c/nix_api_eval_cache.h
 create mode 100644 src/libflake-c/nix_api_eval_cache_internal.hh
 create mode 100644 src/libflake-tests/nix_api_eval_cache.cc

diff --git a/src/libexpr/eval-cache.cc b/src/libexpr/eval-cache.cc
index 7422cd095..695ee875a 100644
--- a/src/libexpr/eval-cache.cc
+++ b/src/libexpr/eval-cache.cc
@@ -373,6 +373,18 @@ ref<AttrCursor> EvalCache::getRoot()
     return make_ref<AttrCursor>(ref(shared_from_this()), std::nullopt);
 }
 
+void EvalCache::checkpoint()
+{
+    if (!db || db->failed)
+        return;
+    auto state(db->_state->lock());
+    try {
+        state->db.exec("pragma wal_checkpoint(passive);");
+    } catch (...) {
+        ignoreExceptionExceptInterrupt();
+    }
+}
+
 AttrCursor::AttrCursor(
     ref<EvalCache> root, Parent parent, Value * value, std::optional<std::pair<AttrId, AttrValue>> && cachedValue)
     : root(root)
diff --git a/src/libexpr/include/nix/expr/eval-cache.hh b/src/libexpr/include/nix/expr/eval-cache.hh
index 0feb7d564..8f7042c83 100644
--- a/src/libexpr/include/nix/expr/eval-cache.hh
+++ b/src/libexpr/include/nix/expr/eval-cache.hh
@@ -50,6 +50,14 @@ public:
     EvalCache(std::optional<std::reference_wrapper<const Hash>> useCache, EvalState & state, RootLoader rootLoader);
 
     ref<AttrCursor> getRoot();
+
+    /**
+     * Fold the WAL into the main `.sqlite` file with a PASSIVE checkpoint, so
+     * a reader of the database file alone (without its `-wal` sidecar) sees
+     * the writes so far. Does not block on concurrent connections. No-op
+     * without a cache.
+     */
+    void checkpoint();
 };
 
 enum AttrType {
