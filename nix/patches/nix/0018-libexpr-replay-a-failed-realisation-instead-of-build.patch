From 776dd780599c81777eb47aff838d17c529e8f967 Mon Sep 17 00:00:00 2001
From: Dennis Wuitz <dennish@wuitz.de>
Date: Thu, 8 Oct 2026 03:51:37 +0200
Subject: [PATCH] libexpr: replay a failed realisation instead of building it
 again

A thunk that threw is forced again on its next use, and when the thunk
is an import from derivation that asks the store to build the same
failing derivation again. A broken derivation imported by many
attributes was thus attempted once per attribute and once per force,
and the attempts of concurrent evaluators serialized on the output lock
of the store.

Keep the exception per EvalState and rethrow it for the rest of the
evaluator's lifetime.
---
 src/libexpr-tests/import-from-derivation.cc | 69 +++++++++++++++++++++
 src/libexpr-tests/meson.build               |  1 +
 src/libexpr/eval.cc                         |  1 +
 src/libexpr/include/nix/expr/eval.hh        |  6 ++
 src/libexpr/primops.cc                      | 17 ++++-
 5 files changed, 93 insertions(+), 1 deletion(-)
 create mode 100644 src/libexpr-tests/import-from-derivation.cc

diff --git a/src/libexpr-tests/import-from-derivation.cc b/src/libexpr-tests/import-from-derivation.cc
new file mode 100644
index 000000000..7aed3b25a
--- /dev/null
+++ b/src/libexpr-tests/import-from-derivation.cc
@@ -0,0 +1,69 @@
+#include <gtest/gtest.h>
+
+#include "nix/expr/tests/libexpr.hh"
+#include "nix/store/globals.hh"
+#include "nix/store/store-open.hh"
+#include "nix/store/tests/forwarding-store.hh"
+#include "nix/util/finally.hh"
+
+namespace nix {
+
+struct FailingBuildStore : ForwardingStore
+{
+    unsigned buildAttempts = 0;
+
+    using ForwardingStore::ForwardingStore;
+
+    void
+    buildPaths(const std::vector<DerivedPath> & paths, BuildMode buildMode, std::shared_ptr<Store> evalStore) override
+    {
+        buildAttempts++;
+        throw Error("the build failed");
+    }
+};
+
+class ImportFromDerivationTest : public LibExprTest
+{
+protected:
+    ref<FailingBuildStore> failing;
+
+    ImportFromDerivationTest()
+        : ImportFromDerivationTest(make_ref<FailingBuildStore>(openStore("dummy://?read-only=false")))
+    {
+    }
+
+    ImportFromDerivationTest(ref<FailingBuildStore> failing)
+        : LibExprTest(
+              failing,
+              [](bool & readOnlyMode) {
+                  EvalSettings settings{readOnlyMode};
+                  settings.nixPath = {};
+                  return settings;
+              })
+        , failing(failing)
+    {
+    }
+};
+
+TEST_F(ImportFromDerivationTest, failedRealisationIsReplayed)
+{
+    bool oldReadOnly = settings.readOnlyMode;
+    settings.readOnlyMode = false;
+    Finally restore([&]() { settings.readOnlyMode = oldReadOnly; });
+
+    Value v = eval(R"(
+      let d = derivation { name = "broken"; system = "x86_64-linux"; builder = "/bin/sh"; };
+      in { a = import d; b = import d; }
+    )");
+    auto * a = v.attrs()->get(createSymbol("a"))->value;
+    auto * b = v.attrs()->get(createSymbol("b"))->value;
+
+    EXPECT_THROW(state.forceValue(*a, noPos), Error);
+    EXPECT_EQ(failing->buildAttempts, 1);
+
+    EXPECT_THROW(state.forceValue(*a, noPos), Error);
+    EXPECT_THROW(state.forceValue(*b, noPos), Error);
+    EXPECT_EQ(failing->buildAttempts, 1) << "a failed realisation is replayed, not attempted again";
+}
+
+} // namespace nix
diff --git a/src/libexpr-tests/meson.build b/src/libexpr-tests/meson.build
index 88e89bbf7..685699857 100644
--- a/src/libexpr-tests/meson.build
+++ b/src/libexpr-tests/meson.build
@@ -51,6 +51,7 @@ sources = files(
   'error_traces.cc',
   'eval-cache.cc',
   'eval.cc',
+  'import-from-derivation.cc',
   'json.cc',
   'lazy-fetcher-attr.cc',
   'main.cc',
diff --git a/src/libexpr/eval.cc b/src/libexpr/eval.cc
index 1867f4da4..aef379be3 100644
--- a/src/libexpr/eval.cc
+++ b/src/libexpr/eval.cc
@@ -307,6 +307,7 @@ EvalState::EvalState(
     , debugStop(false)
     , trylevel(0)
     , rootedValidPaths(make_ref<decltype(rootedValidPaths)::element_type>())
+    , failedRealisations(make_ref<decltype(failedRealisations)::element_type>())
     , importResolutionCache(make_ref<decltype(importResolutionCache)::element_type>())
     , fileEvalCache(make_ref<decltype(fileEvalCache)::element_type>())
     , positionToDocComment(make_ref<decltype(positionToDocComment)::element_type>())
diff --git a/src/libexpr/include/nix/expr/eval.hh b/src/libexpr/include/nix/expr/eval.hh
index 6e9675c9e..f626f309f 100644
--- a/src/libexpr/include/nix/expr/eval.hh
+++ b/src/libexpr/include/nix/expr/eval.hh
@@ -478,6 +478,12 @@ public:
 
 private:
 
+    /**
+     * Derivations whose realisation threw during this evaluation, with the
+     * exception, replayed by `realiseContext()` instead of building again.
+     */
+    const ref<boost::concurrent_flat_map<StorePath, std::exception_ptr>> failedRealisations;
+
     /**
      * A cache that maps paths to "resolved" paths for importing Nix
      * expressions, i.e. `/foo` to `/foo/default.nix`.
diff --git a/src/libexpr/primops.cc b/src/libexpr/primops.cc
index 5c71cae2f..5bcbbc288 100644
--- a/src/libexpr/primops.cc
+++ b/src/libexpr/primops.cc
@@ -127,7 +127,22 @@ StringMap EvalState::realiseContext(const NixStringContext & context, StorePathS
     buildReqs.reserve(drvs.size());
     for (auto & d : drvs)
         buildReqs.emplace_back(DerivedPath{d});
-    buildStore->buildPaths(buildReqs, bmNormal, store);
+
+    /* A thunk that threw is forced again on its next use and would ask the
+       store to build the same failing derivation again. Within this evaluation
+       the failure is replayed instead, so a broken import-from-derivation costs
+       its build attempt once per process rather than once per importer. */
+    for (auto & d : drvs)
+        if (auto failed = getConcurrent(*failedRealisations, d.drvPath->getBaseStorePath()))
+            std::rethrow_exception(*failed);
+
+    try {
+        buildStore->buildPaths(buildReqs, bmNormal, store);
+    } catch (Error &) {
+        if (drvs.size() == 1)
+            failedRealisations->insert_or_assign(drvs.front().drvPath->getBaseStorePath(), std::current_exception());
+        throw;
+    }
 
     StorePathSet outputsToCopyAndAllow;
 
