From 8f1b65ccb6b149cba344ab008edcc55d711419cc Mon Sep 17 00:00:00 2001
From: Dennis Wuitz <dennish@wuitz.de>
Date: Fri, 25 Sep 2026 00:21:27 +0200
Subject: [PATCH 16/16] libstore: name build cgroups after the derivation hash

Port of lix 63871751ce20ab7f3e017d800149432741aec40b.
---
 src/libstore/linux/build/linux-derivation-builder.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/libstore/linux/build/linux-derivation-builder.cc b/src/libstore/linux/build/linux-derivation-builder.cc
index ed40351c2..d983ff0c0 100644
--- a/src/libstore/linux/build/linux-derivation-builder.cc
+++ b/src/libstore/linux/build/linux-derivation-builder.cc
@@ -466,7 +466,7 @@ void ChrootLinuxDerivationBuilder::prepareUser()
         static std::atomic<unsigned int> counter{0};
 
         cgroup = rootCgroupPath
-                 / (buildUser ? fmt("nix-build-uid-%d", buildUser->getUID())
+                 / (buildUser ? fmt("nix-build@%s-%d", drvPath.hashPart(), buildUser->getUID())
                               : fmt("nix-build-pid-%d-%d", getpid(), counter++));
 
         debug("using cgroup %s", PathFmt(*cgroup));
