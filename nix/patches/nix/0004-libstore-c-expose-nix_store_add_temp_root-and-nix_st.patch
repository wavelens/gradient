From 2092cf93a57cc6706bcc273007b5aedcccfe3a59 Mon Sep 17 00:00:00 2001
From: Dennis Wuitz <dennish@wuitz.de>
Date: Sat, 13 Jun 2026 17:48:24 +0200
Subject: [PATCH] libstore-c: expose nix_store_add_temp_root and
 nix_store_add_perm_root

A C API consumer that evaluates and then builds in separate steps has
no way to keep the store paths it holds on to alive across a garbage
collection. Expose the temporary roots of `Store` and the permanent
roots of `LocalFSStore`; the latter fails on a store without a local
filesystem.
---
 src/libstore-c/nix_api_store.cc     | 32 +++++++++++++++
 src/libstore-c/nix_api_store.h      | 30 ++++++++++++++
 src/libstore-tests/nix_api_store.cc | 64 +++++++++++++++++++++++++++++
 3 files changed, 126 insertions(+)

diff --git a/src/libstore-c/nix_api_store.cc b/src/libstore-c/nix_api_store.cc
index fbb3c4185..276164012 100644
--- a/src/libstore-c/nix_api_store.cc
+++ b/src/libstore-c/nix_api_store.cc
@@ -99,6 +99,38 @@ nix_store_get_version(nix_c_context * context, Store * store, nix_get_string_cal
     NIXC_CATCH_ERRS
 }
 
+nix_err nix_store_add_temp_root(nix_c_context * context, Store * store, const StorePath * path)
+{
+    nix_clear_err(context);
+    try {
+        store->ptr->addTempRoot(path->path);
+    }
+    NIXC_CATCH_ERRS
+}
+
+nix_err nix_store_add_perm_root(
+    nix_c_context * context,
+    Store * store,
+    const StorePath * path,
+    const char * gcRoot,
+    nix_get_string_callback callback,
+    void * user_data)
+{
+    nix_clear_err(context);
+    try {
+        if (!gcRoot)
+            throw nix::UsageError("gcRoot must not be null");
+
+        auto localStore = store->ptr.dynamic_pointer_cast<nix::LocalFSStore>();
+        if (!localStore)
+            throw nix::Error("store does not support permanent GC roots: not a local filesystem store");
+
+        auto resultPath = localStore->addPermRoot(path->path, std::filesystem::path(gcRoot));
+        return call_nix_get_string_callback(resultPath.string(), callback, user_data);
+    }
+    NIXC_CATCH_ERRS
+}
+
 bool nix_store_is_valid_path(nix_c_context * context, Store * store, const StorePath * path)
 {
     if (context)
diff --git a/src/libstore-c/nix_api_store.h b/src/libstore-c/nix_api_store.h
index e60a7d6c0..ebade943f 100644
--- a/src/libstore-c/nix_api_store.h
+++ b/src/libstore-c/nix_api_store.h
@@ -185,6 +185,36 @@ nix_err nix_store_realise(
 nix_err
 nix_store_get_version(nix_c_context * context, Store * store, nix_get_string_callback callback, void * user_data);
 
+/**
+ * @brief Register a temporary GC root for a store path (lives until the store is closed).
+ * @param[out] context Optional, stores error information
+ * @param[in] store nix store
+ * @param[in] path the store path to protect
+ * @return NIX_OK if there were no errors.
+ */
+nix_err nix_store_add_temp_root(nix_c_context * context, Store * store, const StorePath * path);
+
+/**
+ * @brief Register a permanent indirect GC root: a symlink at `gcRoot` pointing at `path`.
+ *
+ * Only supported by local filesystem stores; returns an error for remote/binary-cache stores.
+ *
+ * @param[out] context Optional, stores error information
+ * @param[in] store nix store (must be a local store)
+ * @param[in] path the store path to protect
+ * @param[in] gcRoot filesystem location of the gc-root symlink to create
+ * @param[in] callback Called with the resulting root path
+ * @param[in] user_data optional, passed to the callback
+ * @return NIX_OK if there were no errors.
+ */
+nix_err nix_store_add_perm_root(
+    nix_c_context * context,
+    Store * store,
+    const StorePath * path,
+    const char * gcRoot,
+    nix_get_string_callback callback,
+    void * user_data);
+
 /**
  * @brief Create a `nix_derivation` from a JSON representation of that derivation.
  *
diff --git a/src/libstore-tests/nix_api_store.cc b/src/libstore-tests/nix_api_store.cc
index 0162684da..663e008fc 100644
--- a/src/libstore-tests/nix_api_store.cc
+++ b/src/libstore-tests/nix_api_store.cc
@@ -1,5 +1,7 @@
 #include <fstream>
+#include <unistd.h>
 
+#include <gmock/gmock.h>
 #include <nlohmann/json.hpp>
 
 #include "nix_api_util.h"
@@ -977,4 +979,66 @@ TEST_F(nix_api_store_test, nix_derivation_clone)
     nix_derivation_free(drv2);
 }
 
+TEST_F(nix_api_store_test, nix_store_add_temp_root)
+{
+    StorePath * path = nix_store_parse_path(ctx, store, (nixStoreDir + PATH_SUFFIX).c_str());
+    assert_ctx_ok();
+    ASSERT_NE(nullptr, path);
+
+    auto ret = nix_store_add_temp_root(ctx, store, path);
+    assert_ctx_ok();
+    ASSERT_EQ(NIX_OK, ret);
+
+    auto tempRoots = nix::readFile(nixStateDir + "/temproots/" + std::to_string(getpid()));
+    ASSERT_NE(tempRoots.find(nixStoreDir + PATH_SUFFIX), std::string::npos);
+
+    nix_store_path_free(path);
+}
+
+TEST_F(nix_api_store_test, nix_store_add_perm_root)
+{
+    StorePath * path = nix_store_parse_path(ctx, store, (nixStoreDir + PATH_SUFFIX).c_str());
+    assert_ctx_ok();
+    ASSERT_NE(nullptr, path);
+
+    auto tmpDir = nix::createTempDir();
+    nix::AutoDelete delTmpDir(tmpDir, true);
+    auto gcRoot = tmpDir / "gcroot";
+
+    std::string rootOut;
+    auto ret = nix_store_add_perm_root(ctx, store, path, gcRoot.string().c_str(), OBSERVE_STRING(rootOut));
+    assert_ctx_ok();
+    ASSERT_EQ(NIX_OK, ret);
+    ASSERT_EQ(gcRoot.string(), rootOut);
+    ASSERT_EQ(nixStoreDir + PATH_SUFFIX, std::filesystem::read_symlink(gcRoot).string());
+
+    nix_store_path_free(path);
+}
+
+TEST_F(nix_api_util_context, nix_store_add_perm_root_fails_without_local_store)
+{
+    Store * store = nix_store_open(ctx, "dummy://", nullptr);
+    assert_ctx_ok();
+    ASSERT_NE(nullptr, store);
+
+    std::string storeDir;
+    nix_store_get_storedir(ctx, store, OBSERVE_STRING(storeDir));
+    assert_ctx_ok();
+
+    StorePath * path = nix_store_parse_path(ctx, store, (storeDir + PATH_SUFFIX).c_str());
+    assert_ctx_ok();
+    ASSERT_NE(nullptr, path);
+
+    auto tmpDir = nix::createTempDir();
+    nix::AutoDelete delTmpDir(tmpDir, true);
+
+    std::string rootOut;
+    auto ret = nix_store_add_perm_root(ctx, store, path, (tmpDir / "gcroot").string().c_str(), OBSERVE_STRING(rootOut));
+    ASSERT_EQ(NIX_ERR_NIX_ERROR, ret);
+    ASSERT_THAT(nix_err_msg(nullptr, ctx, nullptr), testing::HasSubstr("not a local filesystem store"));
+
+    nix_store_path_free(path);
+    nix_store_free(store);
+}
+
 } // namespace nixC
