From 5c1b7535ad02a93bb61115e96de669d52be6fc7b Mon Sep 17 00:00:00 2001
From: Dennis Wuitz <dennish@wuitz.de>
Date: Sat, 24 Oct 2026 18:59:33 +0200
Subject: [PATCH] libflake-c: expose nix_attr_cursor_force_value

---
 src/libflake-c/nix_api_eval_cache.cc | 15 +++++++++++++++
 src/libflake-c/nix_api_eval_cache.h  |  3 +++
 2 files changed, 18 insertions(+)

diff --git a/src/libflake-c/nix_api_eval_cache.cc b/src/libflake-c/nix_api_eval_cache.cc
index 5bb9936af..859e77565 100644
--- a/src/libflake-c/nix_api_eval_cache.cc
+++ b/src/libflake-c/nix_api_eval_cache.cc
@@ -139,4 +139,19 @@ nix_err nix_attr_cursor_get_list_of_strings(
     NIXC_CATCH_ERRS
 }
 
+nix_value * nix_attr_cursor_force_value(nix_c_context * context, EvalState * state, nix_attr_cursor * cursor)
+{
+    nix_clear_err(context);
+    try {
+        auto & v = cursor->cursor->forceValue();
+        nix_value * ret = new (state->state.mem.allocBytes(sizeof(nix_value))) nix_value{
+            .value = &v,
+            .mem = &state->state.mem,
+        };
+        nix_gc_incref(nullptr, ret);
+        return ret;
+    }
+    NIXC_CATCH_ERRS_NULL
+}
+
 } // extern "C"
diff --git a/src/libflake-c/nix_api_eval_cache.h b/src/libflake-c/nix_api_eval_cache.h
index 47da15b12..838c5467e 100644
--- a/src/libflake-c/nix_api_eval_cache.h
+++ b/src/libflake-c/nix_api_eval_cache.h
@@ -158,6 +158,9 @@ nix_err nix_attr_cursor_get_list_of_strings(
     void (*callback)(const char * value, void * user_data),
     void * user_data);
 
+/** @return A value the caller releases with nix_gc_decref, or NULL on error. */
+nix_value * nix_attr_cursor_force_value(nix_c_context * context, EvalState * state, nix_attr_cursor * cursor);
+
 // cffi end
 #ifdef __cplusplus
 } // extern "C"
-- 
2.55.0

