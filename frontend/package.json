{
  "name": "gradient-frontend",
  "version": "1.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tokens:generate": "node scripts/generate-tokens.mts",
    "tokens:check": "node scripts/generate-tokens.mts --check",
    "barrel:check": "node scripts/check-barrel.mts",
    "lint:styles": "stylelint \"src/**/*.scss\" \"src/styles.scss\"",
    "lint:ts": "eslint src",
    "verify": "pnpm tokens:check && pnpm barrel:check && pnpm lint:styles && pnpm lint:ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "packageManager": "pnpm@10.26.1",
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "d3-sankey": "^0.12.3",
    "echarts": "^6.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@types/d3-sankey": "^0.12.5",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.14.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
